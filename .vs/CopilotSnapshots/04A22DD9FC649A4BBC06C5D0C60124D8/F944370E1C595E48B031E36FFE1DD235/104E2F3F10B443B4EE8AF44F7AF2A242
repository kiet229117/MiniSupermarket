using System;
using System.Collections.Generic;
using System.Drawing;
using System.Net.Http.Json;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace MiniSupermarket.WinForms
{
    public class FormSupplierManagement : Form
    {
        private DataGridView dgv;
        private Label lblStatus;
        private Button btnReload;

        private TextBox txtName;
        private TextBox txtPhone;
        private TextBox txtAddress;
        private Button btnAdd;
        private Button btnUpdate;
        private Button btnDelete;
        private Button btnClear;

        private List<ApiSupplier> suppliers = new List<ApiSupplier>();

        public FormSupplierManagement()
        {
            BuildUI();
            this.Load += FormSupplierManagement_Load;
        }

        private void BuildUI()
        {
            this.Text = "QUẢN LÝ NHÀ CUNG CẤP";
            this.Dock = DockStyle.Fill;

            var top = new Panel { Dock = DockStyle.Top, Height = 48, BackColor = Color.White };
            lblStatus = new Label { Text = "Sẵn sàng", AutoSize = true, Location = new Point(12, 14) };
            btnReload = new Button { Text = "Tải lại", Location = new Point(120, 8), Size = new Size(80, 28) };
            btnReload.Click += async (s, e) => await LoadDataAsync();
            top.Controls.Add(lblStatus);
            top.Controls.Add(btnReload);

            dgv = new DataGridView { Dock = DockStyle.Fill, ReadOnly = true, AllowUserToAddRows = false };
            dgv.Columns.Add("SupplierId", "ID");
            dgv.Columns.Add("SupplierName", "Tên Nhà Cung Cấp");
            dgv.Columns.Add("Phone", "Số điện thoại");
            dgv.Columns.Add("Address", "Địa chỉ");
            dgv.CellClick += Dgv_CellClick;

            // Right panel with CRUD
            var right = new Panel { Dock = DockStyle.Right, Width = 340, BackColor = Color.White, Padding = new Padding(12) };
            var grp = new GroupBox { Text = "Chi tiết nhà cung cấp", Dock = DockStyle.Top, Height = 260 };

            var lbl1 = new Label { Text = "Tên nhà cung cấp:", Location = new Point(12, 28), AutoSize = true };
            txtName = new TextBox { Location = new Point(12, 48), Width = 300 };
            var lbl2 = new Label { Text = "SĐT:", Location = new Point(12, 82), AutoSize = true };
            txtPhone = new TextBox { Location = new Point(12, 102), Width = 300 };
            var lbl3 = new Label { Text = "Địa chỉ:", Location = new Point(12, 136), AutoSize = true };
            txtAddress = new TextBox { Location = new Point(12, 156), Width = 300, Height = 50, Multiline = true };

            grp.Controls.Add(lbl1);
            grp.Controls.Add(txtName);
            grp.Controls.Add(lbl2);
            grp.Controls.Add(txtPhone);
            grp.Controls.Add(lbl3);
            grp.Controls.Add(txtAddress);

            btnAdd = new Button { Text = "Thêm", Location = new Point(12, 216), Size = new Size(80, 30) };
            btnUpdate = new Button { Text = "Sửa", Location = new Point(102, 216), Size = new Size(80, 30) };
            btnDelete = new Button { Text = "Xóa", Location = new Point(192, 216), Size = new Size(80, 30) };
            btnClear = new Button { Text = "Clear", Location = new Point(282, 216), Size = new Size(80, 30) };

            btnAdd.Click += async (s, e) => await CreateSupplierAsync();
            btnUpdate.Click += async (s, e) => await UpdateSupplierAsync();
            btnDelete.Click += async (s, e) => await DeleteSupplierAsync();
            btnClear.Click += (s, e) => ClearForm();

            grp.Controls.Add(btnAdd);
            grp.Controls.Add(btnUpdate);
            grp.Controls.Add(btnDelete);
            grp.Controls.Add(btnClear);

            right.Controls.Add(grp);

            this.Controls.Add(dgv);
            this.Controls.Add(right);
            this.Controls.Add(top);
        }

        private async void FormSupplierManagement_Load(object sender, EventArgs e)
        {
            await LoadDataAsync();
        }

        private async Task LoadDataAsync()
        {
            try
            {
                lblStatus.Text = "Đang tải dữ liệu...";
                var response = await SessionManager.ApiClientService.Client.GetAsync("Suppliers");
                if (!response.IsSuccessStatusCode)
                {
                    await SessionManager.ApiClientService.ShowApiErrorAsync(response, "Tải danh sách nhà cung cấp");
                    lblStatus.Text = "Lỗi tải dữ liệu";
                    return;
                }

                var list = await response.Content.ReadFromJsonAsync<List<ApiSupplier>>();
                suppliers.Clear();
                if (list != null) suppliers.AddRange(list);

                dgv.Rows.Clear();
                foreach (var s in suppliers)
                {
                    int idx = dgv.Rows.Add();
                    var row = dgv.Rows[idx];
                    row.Cells[0].Value = s.SupplierId;
                    row.Cells[1].Value = s.SupplierName;
                    row.Cells[2].Value = s.Phone;
                    row.Cells[3].Value = s.Address;
                }

                lblStatus.Text = $"Có {suppliers.Count} nhà cung cấp";
            }
            catch (Exception ex)
            {
                MessageBox.Show("Lỗi kết nối API: " + ex.Message, "Lỗi", MessageBoxButtons.OK, MessageBoxIcon.Error);
                lblStatus.Text = "Lỗi tải dữ liệu";
            }
        }

        public class ApiSupplier
        {
            public int SupplierId { get; set; }
            public string SupplierName { get; set; } = string.Empty;
            public string Phone { get; set; } = string.Empty;
            public string Address { get; set; } = string.Empty;
        }
    }
}
